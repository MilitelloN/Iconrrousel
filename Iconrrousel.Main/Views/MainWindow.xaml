<Window
    x:Class="Iconrrousel.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Iconrrousel.Main"
    xmlns:conv="clr-namespace:Iconrrousel.Main.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Icon="/Resources/Icono.ico"
    Title="Iconroussel"
    MinWidth="{x:Static local:UIConfiguration+WindowChrome.MinWidth}"
    MaxWidth="{Binding WindowMaxWidth, Source={x:Static local:App.Data}}"
    SizeToContent="Width"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Focusable="False"
    Loaded="Window_Loaded"
    WindowStartupLocation="Manual"
    AllowDrop="True"
    DragEnter="Grid_DragEnter"
    Drop="Grid_Drop"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ShowNamesToSizeConverter x:Key="ShowNamesToSize" />
        <Style x:Key="ModernScrollButton" TargetType="Button">
            <Setter Property="Background" Value="{Binding ScrollButtonBackground, Source={x:Static local:App.Data}}"/>
            <Setter Property="Foreground" Value="{Binding ScrollButtonForeground, Source={x:Static local:App.Data}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{x:Static local:UIConfiguration+ScrollButton.FontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{x:Static local:UIConfiguration+ScrollButton.ButtonCornerRadius}"
                                Padding="{x:Static local:UIConfiguration+ScrollButton.ContentPadding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding ScrollButtonHover, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding ScrollButtonPressed, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding TopButtonForeground, Source={x:Static local:App.Data}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{x:Static local:UIConfiguration+IconButtonChrome.ButtonCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding TopButtonHover, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding TopButtonPressed, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FloatingActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding TopButtonBackground, Source={x:Static local:App.Data}}"/>
            <Setter Property="Width" Value="{x:Static local:UIConfiguration+ActionButtons.Size}"/>
            <Setter Property="Height" Value="{x:Static local:UIConfiguration+ActionButtons.Size}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{x:Static local:UIConfiguration+ActionButtons.ButtonCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding TopButtonHover, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding TopButtonPressed, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{Binding BorderBackground, Source={x:Static local:App.Data}}"
            CornerRadius="{x:Static local:UIConfiguration+WindowChrome.BorderCornerRadius}"
            Margin="{x:Static local:UIConfiguration+WindowChrome.BorderMargin}"
            Padding="{x:Static local:UIConfiguration+WindowChrome.BorderPadding}"
            MaxWidth="{Binding WindowMaxWidth, Source={x:Static local:App.Data}}">
        <Border.Effect>
            <DropShadowEffect Color="{Binding ShadowColor, Source={x:Static local:App.Data}}"
                            Direction="{x:Static local:UIConfiguration+WindowChrome.ShadowDirection}"
                            ShadowDepth="{x:Static local:UIConfiguration+WindowChrome.ShadowDepth}"
                            BlurRadius="{x:Static local:UIConfiguration+WindowChrome.ShadowBlurRadius}"
                            Opacity="{x:Static local:UIConfiguration+WindowChrome.ShadowOpacity}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="{x:Static local:UIConfiguration+WindowChrome.ContentRowMinHeight}" />
            </Grid.RowDefinitions>

            <Grid Margin="{x:Static local:UIConfiguration+WindowChrome.InnerGridMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scroll content -->
                <ScrollViewer x:Name="IconViewer"
                              Grid.Column="1"
                              MinWidth="{x:Static local:UIConfiguration+IconViewer.MinWidth}"
                              MaxWidth="{Binding IconViewerWidth, Source={x:Static local:App.Data}}"
                              Margin="0"
                              Padding="{x:Static local:UIConfiguration+IconViewer.Padding}"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <!-- Iconos como tabla: cada icono es una celda (UniformGrid reparte
                         Rows x Columns fila por fila, izquierda-derecha y arriba-abajo).
                         Rows/Columns/Width/Height se fijan desde el code-behind
                         (MainWindow.UpdateIconLayout) segun cantidad de iconos, tamano
                         de ventana elegido y si esta expandida o no. -->
                    <UniformGrid x:Name="IconsPanel"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center" />
                </ScrollViewer>

                <!-- Left button -->
                <Button
                    x:Name="ScrollLeft"
                    Grid.Column="0"
                    Content="◀"
                    Style="{StaticResource ModernScrollButton}"
                    ClickMode="Press"
                    Click="ScrollLeft_Click"
                    Width="{x:Static local:UIConfiguration+ScrollButton.Width}"
                    Height="{x:Static local:UIConfiguration+ScrollButton.Height}"
                    Margin="{x:Static local:UIConfiguration+ScrollButton.LeftMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"/>

                <!-- Right button -->
                <Button
                    x:Name="ScrollRight"
                    Grid.Column="2"
                    Content="▶"
                    Style="{StaticResource ModernScrollButton}"
                    ClickMode="Press"
                    Click="ScrollRight_Click"
                    Width="{x:Static local:UIConfiguration+ScrollButton.Width}"
                    Height="{x:Static local:UIConfiguration+ScrollButton.Height}"
                    Margin="{x:Static local:UIConfiguration+ScrollButton.RightMargin}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"/>
            </Grid>

            <!-- Filtros / Expandir: flotan sobre los iconos (no ocupan espacio en el
                 layout), siempre a la misma distancia del borde inferior (Canvas.Bottom
                 fijo), sea la ventana colapsada o expandida. Filtros se ancla al borde
                 IZQUIERDO y Expandir al borde DERECHO (Canvas.Right) en vez de un
                 Canvas.Left por tamano: la ventana tiene ancho dinamico segun la
                 cantidad de iconos guardados (ver UpdateIconLayout), asi que un
                 Canvas.Left pensado para el ancho maximo del tamano elegido dejaba a
                 Expandir fuera de la ventana (invisible) cuando el ancho real era menor. -->
            <Canvas Panel.ZIndex="2" IsHitTestVisible="True">
                <Button x:Name="FiltrosButton"
                        Style="{StaticResource FloatingActionButtonStyle}"
                        Canvas.Left="{x:Static local:UIConfiguration+ActionButtons.FiltrosLeftOffset}"
                        Canvas.Bottom="{x:Static local:UIConfiguration+ActionButtons.BottomOffset}"
                        Click="FiltrosButton_Click"
                        ToolTip="Filtros">
                    <Path Data="M4,5 L20,5 L13.5,12.5 L13.5,19 L10.5,20.5 L10.5,12.5 Z"
                          Stroke="{Binding TopButtonForeground, Source={x:Static local:App.Data}}"
                          StrokeThickness="{x:Static local:UIConfiguration+ActionButtons.IconStrokeThickness}"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="{x:Static local:UIConfiguration+ActionButtons.IconGlyphSize}"
                          Height="{x:Static local:UIConfiguration+ActionButtons.IconGlyphSize}"/>
                </Button>
                <Button x:Name="ExpandirButton"
                        Style="{StaticResource FloatingActionButtonStyle}"
                        Canvas.Right="{x:Static local:UIConfiguration+ActionButtons.ExpandirRightOffset}"
                        Canvas.Bottom="{x:Static local:UIConfiguration+ActionButtons.BottomOffset}"
                        Click="ExpandirButton_Click"
                        ToolTip="Expandir">
                    <Path x:Name="ExpandirChevron"
                          Data="M6,9 L12,15 18,9"
                          Stroke="{Binding TopButtonForeground, Source={x:Static local:App.Data}}"
                          StrokeThickness="{x:Static local:UIConfiguration+ActionButtons.IconStrokeThickness}"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="{x:Static local:UIConfiguration+ActionButtons.IconGlyphSize}"
                          Height="{x:Static local:UIConfiguration+ActionButtons.IconGlyphSize}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ExpandirChevronRotation" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Canvas>
        </Grid>
    </Border>
</Window>
