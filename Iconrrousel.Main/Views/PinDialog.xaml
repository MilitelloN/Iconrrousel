<Window x:Class="Iconrrousel.Main.PinDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:Iconrrousel.Main"
		Title="PIN" Width="340" SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		Background="{Binding BorderBackground, Source={x:Static local:App.Data}}"
		ResizeMode="NoResize">
	<Window.Resources>
		<Style x:Key="DialogButton" TargetType="Button">
			<Setter Property="Background" Value="{Binding TopButtonBackground, Source={x:Static local:App.Data}}"/>
			<Setter Property="Foreground" Value="{Binding TopButtonForeground, Source={x:Static local:App.Data}}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,5">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{Binding TopButtonHover, Source={x:Static local:App.Data}}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{Binding TopButtonPressed, Source={x:Static local:App.Data}}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PinBoxStyle" TargetType="PasswordBox">
			<Setter Property="Width" Value="120"/>
			<Setter Property="Height" Value="35"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="MaxLength" Value="4"/>
			<Setter Property="Foreground" Value="{Binding IconTextForeground, Source={x:Static local:App.Data}}"/>
			<Setter Property="Background" Value="{Binding TopButtonBackground, Source={x:Static local:App.Data}}"/>
			<Setter Property="BorderBrush" Value="{Binding TopButtonHover, Source={x:Static local:App.Data}}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
		</Style>
	</Window.Resources>

	<Border Background="{Binding BorderBackground, Source={x:Static local:App.Data}}" Padding="15">
		<StackPanel>
			<TextBlock x:Name="TitleText"
					   FontSize="15"
					   FontWeight="Bold"
					   TextWrapping="Wrap"
					   TextAlignment="Center"
					   Margin="0,0,0,12"
					   Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}"/>

			<PasswordBox x:Name="PinBox"
						 Style="{StaticResource PinBoxStyle}"
						 PreviewTextInput="PinBox_PreviewTextInput"/>

			<TextBlock x:Name="ConfirmLabel"
					   Text="Confirmar PIN"
					   HorizontalAlignment="Center"
					   Margin="0,10,0,4"
					   Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}"/>
			<PasswordBox x:Name="ConfirmBox"
						 Style="{StaticResource PinBoxStyle}"
						 PreviewTextInput="PinBox_PreviewTextInput"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
				<Button Content="OK"
						Width="110"
						Height="36"
						IsDefault="True"
						Click="OK_Click"
						Margin="0,0,15,0"
						Style="{StaticResource DialogButton}"/>
				<Button Content="Cancelar"
						Width="110"
						Height="36"
						IsCancel="True"
						Click="Cancel_Click"
						Style="{StaticResource DialogButton}"/>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
