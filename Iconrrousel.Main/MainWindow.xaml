<Window
    x:Class="Iconrrousel.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Iconrrousel.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Iconroussel"
    Height="{Binding WinHeight, Mode=TwoWay}"
    MinWidth="170"
    MaxWidth="720"
    SizeToContent="Width"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    AllowDrop="True"
    DragEnter="Grid_DragEnter"
    Drop="Grid_Drop"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    mc:Ignorable="d">
    
    <Window.Resources>
        <Style x:Key="ModernScrollButton" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#70FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#E0000000" 
            CornerRadius="15" 
            Margin="10"
            Padding="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="5" 
                            BlurRadius="20" 
                            Opacity="0.7"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="OpenConfigButton"
                Grid.Row="0"
                Content="⚙"
                Style="{StaticResource TopButton}"
                Width="35"
                Height="26"
                Margin="0,0,0,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"/>

            <Grid Grid.Row="1" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="ScrollLeft"
                    Grid.Column="0"
                    Content="◀" 
                    Style="{StaticResource ModernScrollButton}"
                    ClickMode="Press" 
                    Click="ScrollLeft_Click"
                    Width="40" 
                    Height="80"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"/>

                <ScrollViewer x:Name="IconViewer" 
                            Grid.Column="1" 
                            MinWidth="50"
                            MaxWidth="600"
                            Margin="4,0,4,0" 
                            HorizontalScrollBarVisibility="Hidden" 
                            VerticalScrollBarVisibility="Disabled"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <WrapPanel x:Name="IconsPanel" 
                               Orientation="Horizontal" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </ScrollViewer>

                <Button
                    x:Name="ScrollRight" 
                    Grid.Column="2"
                    Content="▶"
                    Style="{StaticResource ModernScrollButton}"
                    ClickMode="Press"
                    Click="ScrollRight_Click"
                    Width="40"
                    Height="80"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
