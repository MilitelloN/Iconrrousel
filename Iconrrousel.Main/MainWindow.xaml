<Window x:Class="Iconrrousel.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Iconrrousel.Main"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        AllowDrop="True"
        DragEnter="Grid_DragEnter"
        Drop="Grid_Drop">
    <Grid>

        <!-- DEFINICIÓN DE FILAS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Info -->
            <RowDefinition Height="*"/>
            <!-- Iconos -->
            <RowDefinition Height="Auto"/>
            <!-- Acción -->
        </Grid.RowDefinitions>

        <!-- INFO SUPERIOR -->
        <Label x:Name="InfoLabel"
           Grid.Row="0"
           Content="Información del ícono"
           Margin="10"
           FontWeight="Bold"/>

        <!-- VISOR DE ICONOS -->
        <ScrollViewer Grid.Row="1"
                  x:Name="IconViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  Margin="10">

            <WrapPanel x:Name="IconsPanel"
                   Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- ZONA INFERIOR -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icono seleccionado -->
            <Image x:Name="IconImage"
               Width="64"
               Height="64"
               Margin="5"/>

            <!-- Ruta / nombre -->
            <Label x:Name="buttonLabel"
               Grid.Column="1"
               VerticalAlignment="Center"
               Margin="10,0"/>

            <!-- Botón -->
            <Button x:Name="buttonGame"
                Grid.Column="2"
                Content="Abrir"
                Padding="15,5"
                Click="OpenLink_Click"/>
        </Grid>

    </Grid>
</Window>
