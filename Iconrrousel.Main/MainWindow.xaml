<Window
    x:Class="Iconrrousel.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Iconrrousel.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Iconroussel"
    Width="{Binding WinWidth,Mode=TwoWay}"
    Height="{Binding WinHeight,Mode=TwoWay}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    AllowDrop="True"
    DragEnter="Grid_DragEnter"
    Drop="Grid_Drop"
    Background="#00000000"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#00000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
    
            </Grid.ColumnDefinitions>

            <Button
                    x:Name="ScrollLeft"
                    Grid.Column="0"
                    Content="&lt;&lt;" 
                    HorizontalAlignment="Left" 
                    ClickMode="Press" 
                    Click="ScrollLeft_Click"
                    Width="40" 
                    Height="Auto" 
                    Background="#CF3F4042"/>

            <Button
                    x:Name="ScrollRight" 
                    Grid.Column="2"
                    Content="&gt;&gt;"
                    HorizontalAlignment="Right" 
                    ClickMode="Press"
                    Click="ScrollRight_Click"
                    Width="40"
                    Height="Auto" 
                    Background="#CF3F4042"/>

            <ScrollViewer x:Name="IconViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="IconsPanel" Orientation="Horizontal" Height="120" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
