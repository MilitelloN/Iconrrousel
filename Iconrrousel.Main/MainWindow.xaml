<Window
    x:Class="Iconrrousel.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Iconrrousel.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Iconroussel"
    Width="{Binding WinWidth, Mode=TwoWay}"
    Height="{Binding WinHeight, Mode=TwoWay}"
    AllowDrop="True"
    Background="#01000000"
    DragEnter="Grid_DragEnter"
    Drop="Grid_Drop"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.ColumnSpan="3"
            Padding="4"
            HorizontalAlignment="Center"
            Background="#01000000"
            CornerRadius="8">
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <Button
                    x:Name="ScrollLeft"
                    Grid.Column="0"
                    Width="40"
                    Height="Auto"
                    HorizontalAlignment="Left"
                    Background="#CF3F4042"
                    Click="ScrollLeft_Click"
                    ClickMode="Press"
                    Content="&lt;&lt;" />

                <Button
                    x:Name="ScrollRight"
                    Grid.Column="2"
                    Width="40"
                    Height="Auto"
                    HorizontalAlignment="Right"
                    Background="#CF3F4042"
                    Click="ScrollRight_Click"
                    ClickMode="Press"
                    Content="&gt;&gt;" />

                <ScrollViewer
                    x:Name="IconViewer"
                    Grid.Column="1"
                    Width="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
                    <WrapPanel
                        x:Name="IconsPanel"
                        Width="Auto"
                        Height="auto"
                        MinHeight="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
