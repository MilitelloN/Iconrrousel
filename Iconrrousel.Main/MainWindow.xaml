<Window
    x:Class="Iconrrousel.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Iconrrousel.Main"
    xmlns:conv="clr-namespace:Iconrrousel.Main.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Iconroussel"
    Height="160"
    MinWidth="320"
    SizeToContent="Width"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    WindowStartupLocation="Manual"
    AllowDrop="True"
    DragEnter="Grid_DragEnter"
    Drop="Grid_Drop"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    mc:Ignorable="d">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ShowNamesToSizeConverter x:Key="ShowNamesToSize" />
        <Style x:Key="ModernScrollButton" TargetType="Button">
            <Setter Property="Background" Value="{Binding ScrollButtonBackground, Source={x:Static local:App.Data}}"/>
            <Setter Property="Foreground" Value="{Binding ScrollButtonForeground, Source={x:Static local:App.Data}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding ScrollButtonHover, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding ScrollButtonPressed, Source={x:Static local:App.Data}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
     </Window.Resources>
     
    <Border Background="{Binding BorderBackground, Source={x:Static local:App.Data}}" 
            CornerRadius="15" 
            Margin="8"
            Padding="4">
        <Border.Effect>
            <DropShadowEffect Color="{Binding ShadowColor, Source={x:Static local:App.Data}}" 
                            Direction="270" 
                            ShadowDepth="5" 
                            BlurRadius="20" 
                            Opacity="0.7"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="110" />
            </Grid.RowDefinitions>

            <Grid Margin="5,0,5,0">
                <!-- Scroll content -->
                <ScrollViewer x:Name="IconViewer" 
                              MinWidth="50"
                              MaxWidth="600"
                              Margin="0"
                              Padding="28,2,28,6"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <WrapPanel x:Name="IconsPanel" 
                               Orientation="Horizontal" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </ScrollViewer>

                <!-- Overlayed buttons -->
                <Button
                    x:Name="ScrollLeft"
                    Content="◀" 
                    Style="{StaticResource ModernScrollButton}"
                    ClickMode="Press" 
                    Click="ScrollLeft_Click"
                    Width="38" 
                    Height="72"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"/>

                <Button
                    x:Name="ScrollRight" 
                    Content="▶"
                    Style="{StaticResource ModernScrollButton}"
                    ClickMode="Press"
                    Click="ScrollRight_Click"
                    Width="38"
                    Height="72"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"/>
            </Grid>
        </Grid>
    </Border>
</Window>
