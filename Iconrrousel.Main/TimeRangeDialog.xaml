<Window x:Class="Iconrrousel.Main.TimeRangeDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:Iconrrousel.Main"
		Title="Time Range Configuration" Height="320" Width="380"
		WindowStartupLocation="CenterOwner"
		Background="{Binding BorderBackground, Source={x:Static local:App.Data}}"
		ResizeMode="NoResize">
	<Window.Resources>
		<Style x:Key="DialogButton" TargetType="Button">
			<Setter Property="Background" Value="{Binding TopButtonBackground, Source={x:Static local:App.Data}}"/>
			<Setter Property="Foreground" Value="{Binding TopButtonForeground, Source={x:Static local:App.Data}}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,5">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{Binding TopButtonHover, Source={x:Static local:App.Data}}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{Binding TopButtonPressed, Source={x:Static local:App.Data}}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TimeTextBox" TargetType="TextBox">
			<Setter Property="Width" Value="70"/>
			<Setter Property="Height" Value="35"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="MaxLength" Value="2"/>
			<Setter Property="Foreground" Value="{Binding IconTextForeground, Source={x:Static local:App.Data}}"/>
			<Setter Property="Background" Value="{Binding TopButtonBackground, Source={x:Static local:App.Data}}"/>
			<Setter Property="BorderBrush" Value="{Binding TopButtonHover, Source={x:Static local:App.Data}}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
	</Window.Resources>

	<Border Background="{Binding BorderBackground, Source={x:Static local:App.Data}}" 
			Padding="15" 
			CornerRadius="10" 
			BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Title -->
			<TextBlock Text="Configure blocking time range" 
					   Grid.Row="0" 
					   FontSize="18" 
					   FontWeight="Bold" 
					   Margin="0,0,0,10" 
					   Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}" 
					   HorizontalAlignment="Center"/>

			<!-- Start Time Section -->
			<GroupBox Header="Start Time" 
					  Grid.Row="1" 
					  Margin="0,0,0,8" 
					  Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}"
					  Background="Transparent"
					  BorderThickness="0">
				<Grid HorizontalAlignment="Center" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBox x:Name="StartHourBox" 
							 Grid.Column="0" 
							 Style="{StaticResource TimeTextBox}"/>
					<TextBlock Grid.Column="1" 
							   Text=":" 
							   FontSize="20"
							   FontWeight="Bold"
							   VerticalAlignment="Center" 
							   HorizontalAlignment="Center" 
							   Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}"/>
					<TextBox x:Name="StartMinuteBox" 
							 Grid.Column="2" 
							 Style="{StaticResource TimeTextBox}"/>
				</Grid>
			</GroupBox>

			<!-- End Time Section -->
			<GroupBox Header="End Time" 
					  Grid.Row="2" 
					  Margin="0,0,0,8" 
					  Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}"
					  Background="Transparent"
					  BorderThickness="0">
				<Grid HorizontalAlignment="Center" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBox x:Name="EndHourBox" 
							 Grid.Column="0" 
							 Style="{StaticResource TimeTextBox}"/>
					<TextBlock Grid.Column="1" 
							   Text=":" 
							   FontSize="20"
							   FontWeight="Bold"
							   VerticalAlignment="Center" 
							   HorizontalAlignment="Center" 
							   Foreground="{Binding IconTextForeground, Source={x:Static local:App.Data}}"/>
					<TextBox x:Name="EndMinuteBox" 
							 Grid.Column="2" 
							 Style="{StaticResource TimeTextBox}"/>
				</Grid>
			</GroupBox>

			<!-- Buttons -->
			<StackPanel Grid.Row="4" 
						Orientation="Horizontal" 
						HorizontalAlignment="Center" 
						Margin="0,10,0,0">
				<Button Content="OK" 
						Width="120" 
						Height="38" 
						Click="OK_Click" 
						Margin="0,0,15,0" 
						Style="{StaticResource DialogButton}"/>
				<Button Content="Cancel" 
						Width="120" 
						Height="38" 
						Click="Cancel_Click" 
						Style="{StaticResource DialogButton}"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>
